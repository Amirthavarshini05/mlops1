pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/USERNAME/student-result-app.git'
            }
        }

        stage('Test') {
            steps {
                bat 'echo Testing Student Result Application'
                bat 'if not exist index.html exit /b 1'
                bat 'if not exist style.css exit /b 1'
                bat 'if not exist script.js exit /b 1'
                bat 'echo Test Passed'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t student-result-app .'
            }
        }

        stage('Deploy Container') {
            steps {
                bat 'docker stop student-result-container 2>NUL || exit 0'
                bat 'docker rm student-result-container 2>NUL || exit 0'
                bat 'docker run -d --name student-result-container -p 8081:80 student-result-app'
            }
        }

        stage('Verify') {
            steps {
                bat 'docker ps'
                bat 'docker inspect student-result-container'
                bat 'echo Deployment Verified Successfully'
            }
        }
    }
}
